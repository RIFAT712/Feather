# Wikimedia OAuth application credentials
WIKIMEDIA_CLIENT_ID=your-wikimedia-client-id
WIKIMEDIA_CLIENT_SECRET=your-wikimedia-client-secret

# Use a long random value in production
SESSION_SECRET=replace-with-a-long-random-secret
OAUTH_CALLBACK_URL=http://localhost:3000/auth/callback

# Local SSH tunnel: -L 4407:bnwiktionary.web.db.svc.wikimedia.cloud:3306
WIKI_DB_HOST=127.0.0.1
WIKI_DB_PORT=4407
WIKI_DB_USER=
WIKI_DB_PASSWORD=
